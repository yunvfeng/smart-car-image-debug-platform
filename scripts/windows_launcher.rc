#include <windows.h>
1 ICON "visionlab.ico"
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "VisionLab Smart Car Image Debug Platform\0"
            VALUE "FileVersion", "@VERSION@\0"
            VALUE "ProductName", "VisionLab\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
